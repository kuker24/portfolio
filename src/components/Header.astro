---
import { sectionHref, siteData } from '../data/site';

const navItems = [
  { label: 'About', href: sectionHref('about') },
  { label: 'Work', href: sectionHref('projects') },
  { label: 'Contact', href: sectionHref('contact') },
];
---

<header
  transition:persist="site-nav"
  class="site-header"
>
  <div class="site-pill">
    <a
      href={`${siteData.basePath}/`}
      class="pressable site-mark"
      aria-label={`${siteData.name} home`}
    >
      <span>FH</span>
    </a>

    <span class="site-rule" aria-hidden="true"></span>

    <nav class="site-nav" aria-label="Primary">
      {navItems.map((item) => (
        <a href={item.href} class="pressable site-nav-link">
          {item.label}
        </a>
      ))}
    </nav>

    <span class="site-rule" aria-hidden="true"></span>

    <a
      href={siteData.socials.github.url}
      target="_blank"
      rel="noopener noreferrer"
      class="pressable site-nav-github"
    >
      GitHub
      <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M3 9L9 3M5 3h4v4"></path>
      </svg>
    </a>

    <button
      id="mobile-menu-btn"
      type="button"
      class="pressable site-menu-btn"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path stroke-linecap="round" d="M5 8h14M5 16h14"></path>
      </svg>
    </button>
  </div>
</header>

<div
  id="mobile-menu"
  class="site-drawer"
  data-open="false"
>
  <nav aria-label="Mobile">
    {navItems.map((item) => (
      <a href={item.href} class="mobile-nav-link pressable">
        {item.label}
      </a>
    ))}
    <a
      href={siteData.socials.github.url}
      target="_blank"
      rel="noopener noreferrer"
      class="mobile-nav-link pressable"
    >
      GitHub
    </a>
  </nav>
</div>

<script>
  import { bindMenu } from '../scripts/menu';

  bindMenu();
  document.addEventListener('astro:page-load', () => bindMenu());
</script>

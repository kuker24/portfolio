---
import { siteData } from '../data/site';

const navItems = [
  { label: 'About', href: '#about' },
  { label: 'Projects', href: '#projects' },
  { label: 'Capabilities', href: '#capabilities' },
  { label: 'Principles', href: '#principles' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="sticky top-0 z-50 bg-void/90 backdrop-blur-md border-b border-graphite transition-all duration-200">
  <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href={`${siteData.basePath}/`} class="flex items-center gap-2.5 group focus:outline-none focus:ring-1 focus:ring-violet rounded-btn px-2 py-1 text-[15px]">
      <span class="font-mono text-xs text-violet group-hover:text-violet-glow transition-colors">[ FH ]</span>
      <span class="font-sans font-medium text-sm text-white tracking-tight group-hover:text-bone transition-colors">{siteData.name}</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-6" aria-label="Main Navigation">
      {navItems.map(item => (
        <a
          href={item.href}
          class="font-sans text-sm text-smoke hover:text-white transition-colors duration-150 px-2.5 py-1.5 rounded-btn focus:outline-none focus:ring-1 focus:ring-violet"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Desktop CTA -->
    <div class="hidden md:flex items-center gap-4">
      <a
        href={siteData.socials.github.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-btn border border-graphite text-xs font-mono text-white bg-transparent hover:border-white transition-all duration-150"
      >
        <span>github.com/kuker24</span>
        <svg class="w-3.5 h-3.5 text-ash" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden p-2 rounded-btn border border-graphite text-smoke hover:text-white hover:border-white transition-colors"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle navigation menu"
    >
      <svg id="menu-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer Navigation -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-graphite bg-void px-4 pt-3 pb-6 space-y-4">
    <nav class="flex flex-col space-y-3">
      {navItems.map(item => (
        <a
          href={item.href}
          class="mobile-nav-link font-sans text-base text-smoke hover:text-white transition-colors py-1"
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="pt-2 border-t border-graphite/50">
      <a
        href={siteData.socials.github.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-full items-center justify-center gap-2 px-4 py-2 rounded-btn border border-graphite text-xs font-mono text-white bg-transparent hover:border-white transition-colors"
      >
        <span>github.com/kuker24</span>
        <svg class="w-3.5 h-3.5 text-ash" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');
  const links = document.querySelectorAll('.mobile-nav-link');

  if (btn && menu && menuIcon && closeIcon) {
    const toggle = () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
      menuIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    };

    btn.addEventListener('click', toggle);

    links.forEach(link => {
      link.addEventListener('click', () => {
        if (!menu.classList.contains('hidden')) {
          toggle();
        }
      });
    });
  }
</script>

---
import { siteData } from '../data/site';

const links = [siteData.socials.github, siteData.socials.linkedin, siteData.socials.x];
---

<section id="contact" class="section contact-stage scroll-mt-24">
  <div class="contact-world" aria-hidden="true">
    <picture>
      <source srcset={siteData.nebula.webp} type="image/webp" />
      <img
        src={siteData.nebula.jpeg}
        alt=""
        width={siteData.nebula.width}
        height={siteData.nebula.height}
        class="contact-nebula"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div class="contact-read"></div>
  </div>

  <div class="section-inner contact-inner" data-reveal>
    <h2 class="section-title contact-title">Connect and <em>collaborate</em></h2>
    <p class="section-lede">
      Open for conversations on school systems, AI instruction, and software collaboration.
    </p>

    <div class="contact-bands">
      {links.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="pressable contact-band"
        >
          <span class="contact-label">{link.label}</span>
          <span class="contact-handle">{link.username}</span>
          <svg class="contact-go" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M3 9L9 3M5 3h4v4"></path>
          </svg>
        </a>
      ))}
    </div>
  </div>
</section>

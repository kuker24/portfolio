---
import { siteData } from '../data/site';
---

<section id="about" class="section about-stage scroll-mt-24">
  <div class="section-inner about-inner" data-reveal>
    <p class="about-place" aria-hidden="true">{siteData.location.split(',')[0]}</p>
    <h2 class="section-title about-title">
      Engineering and <em>instruction</em>
    </h2>
    <p class="about-lead">{siteData.about.intro}</p>
    <div class="about-copy">
      {siteData.about.narrative.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </div>
</section>

---
import { siteData } from '../data/site';
---

<section id="capabilities" class="section capabilities-stage scroll-mt-24">
  <div class="section-inner">
    <header class="capabilities-header" data-reveal>
      <h2 class="section-title">How I <em>work</em></h2>
      <p class="section-lede">
        Full-stack engineering, school-system architecture, security controls, and classroom AI instruction.
      </p>
    </header>

    <div class="capability-field" data-reveal>
      {siteData.capabilities.map((capability) => (
        <article class="capability">
          <h3>{capability.title}</h3>
          <p>{capability.description}</p>
          <p class="capability-skills">{capability.skills.join(' · ')}</p>
        </article>
      ))}
    </div>
  </div>
</section>

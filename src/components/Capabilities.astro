---
import { siteData } from '../data/site';
---

<section id="capabilities" class="py-20 border-b border-graphite">
  <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Section Header -->
    <div class="space-y-4 max-w-2xl">
      <div class="inline-flex items-center">
        <span class="font-mono text-xs text-violet font-medium">Capabilities</span>
      </div>
      <h2 class="font-sans text-3xl sm:text-5xl text-white font-medium tracking-tight">
        Capabilities &amp; Stack
      </h2>
      <p class="font-sans text-base text-ash leading-relaxed">
        Core technical domains across full-stack engineering, educational platform architecture, security controls, and AI instruction.
      </p>
    </div>

    <!-- 3-Column Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {siteData.capabilities.map((capability) => (
        <div class="rounded-card border border-graphite bg-void p-6 sm:p-8 space-y-6 flex flex-col justify-between hover:border-smoke/40 transition-colors duration-200">
          <div class="space-y-3">
            <h3 class="font-sans text-xl text-white font-medium tracking-tight">
              {capability.title}
            </h3>
            <p class="font-sans text-sm text-ash leading-relaxed">
              {capability.description}
            </p>
          </div>

          <!-- Skills Tag Cloud -->
          <div class="pt-4 border-t border-graphite/60 flex flex-wrap gap-1.5">
            {capability.skills.map(skill => (
              <span class="font-mono text-xs text-smoke bg-void border border-graphite rounded-btn px-2.5 py-1">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

---
import { siteData } from '../data/site';
---

<div class="nebula-field" data-nebula>
  <picture>
    <source srcset={siteData.nebula.webp} type="image/webp" />
    <img
      src={siteData.nebula.jpeg}
      alt=""
      width={siteData.nebula.width}
      height={siteData.nebula.height}
      class="hero-nebula-media hero-nebula-still"
      loading="eager"
      decoding="async"
    />
  </picture>
</div>

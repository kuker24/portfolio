---
import { siteData } from '../data/site';
---

<section id="principles" class="section principles-stage scroll-mt-24">
  <div class="section-inner">
    <h2 class="section-title">How I <em>decide</em></h2>
    <div class="principle-stack" data-reveal>
      {siteData.principles.map((principle) => (
        <article class="principle">
          <h3>{principle.title}</h3>
          <p>{principle.detail}</p>
        </article>
      ))}
    </div>
  </div>
</section>

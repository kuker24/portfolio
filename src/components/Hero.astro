---
import { siteData } from '../data/site';
import NebulaField from './NebulaField.astro';

const givenName = siteData.name.split(' ')[0];
const familyName = siteData.name.split(' ').slice(1).join(' ');
---

<section class="hero-stage" aria-labelledby="hero-name">
  <div class="hero-world" aria-hidden="true">
    <NebulaField />
    <div class="hero-read"></div>
    <svg class="hero-grain" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <filter id="hero-noise" x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="4" stitchTiles="stitch" />
        <feColorMatrix type="saturate" values="0" />
      </filter>
      <rect width="100%" height="100%" filter="url(#hero-noise)" opacity="0.22"></rect>
    </svg>
    <svg class="hero-arc" viewBox="0 0 1440 900" preserveAspectRatio="none">
      <defs>
        <linearGradient id="hero-arc-stroke" x1="0" y1="1" x2="1" y2="0">
          <stop offset="0%" stop-color="#89AACC" stop-opacity="0"></stop>
          <stop offset="28%" stop-color="#89AACC"></stop>
          <stop offset="72%" stop-color="#4E85BF"></stop>
          <stop offset="100%" stop-color="#4E85BF" stop-opacity="0.15"></stop>
        </linearGradient>
      </defs>
      <path
        class="hero-arc-path"
        d="M-48 848 C 260 792, 360 430, 640 468 S 980 620, 1148 286 S 1360 72, 1520 36"
        fill="none"
        stroke="url(#hero-arc-stroke)"
        stroke-width="1.35"
        stroke-linecap="round"
      ></path>
      <circle class="hero-arc-node" cx="220" cy="760" r="2.6" fill="#89AACC"></circle>
      <circle class="hero-arc-node" cx="640" cy="468" r="2.6" fill="#89AACC"></circle>
      <circle class="hero-arc-node" cx="1148" cy="286" r="3.1" fill="#4E85BF"></circle>
    </svg>
  </div>

  <div class="hero-layout">
    <div class="hero-ridge">
      <h1 id="hero-name" class="hero-name">
        <span class="hero-enter hero-given">{givenName}</span>
        <span class="hero-enter hero-family">{familyName}</span>
      </h1>
      <div class="hero-copy">
        <p class="hero-enter hero-role">{siteData.title}</p>
        <p class="hero-enter hero-intro">{siteData.about.intro}</p>
        <div class="hero-actions">
          <a href="#projects" class="hero-enter hero-cta pressable">See work</a>
          <a
            href={siteData.socials.github.url}
            target="_blank"
            rel="noopener noreferrer"
            class="hero-enter hero-cta-alt pressable"
          >
            GitHub
          </a>
        </div>
        <p class="hero-enter hero-place">{siteData.location}</p>
      </div>
    </div>

    <figure class="hero-enter hero-moon">
      <span class="hero-moon-ring" aria-hidden="true"></span>
      <picture>
        <source srcset={siteData.photo.webp} type="image/webp" />
        <img
          src={siteData.photo.jpeg}
          alt={siteData.photo.alt}
          width={siteData.photo.width}
          height={siteData.photo.height}
          class="hero-moon-photo"
          loading="eager"
          decoding="async"
        />
      </picture>
    </figure>
  </div>

  <a href="#about" class="hero-enter hero-scroll">
    Scroll
    <span class="hero-scroll-line" aria-hidden="true"></span>
  </a>
</section>

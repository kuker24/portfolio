---
import { siteData } from '../data/site';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 border-b border-graphite">
  <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Hero Text & Positioning -->
      <div class="lg:col-span-7 flex flex-col items-start text-left space-y-6">
        
        <!-- Mono Eyebrow -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-badge border border-graphite bg-void">
          <span class="w-2 h-2 rounded-full bg-violet animate-pulse"></span>
          <span class="font-mono text-xs text-violet font-medium tracking-wide">
            &gt; FULL-STACK &amp; AI EDUCATOR
          </span>
        </div>

        <!-- Main Display Headline (Serif Editorial) -->
        <h1 class="font-serif text-5xl sm:text-7xl lg:text-8xl text-white font-normal leading-none tracking-tight">
          {siteData.name}
        </h1>

        <!-- Positioning Sub-headline -->
        <p class="font-sans text-lg sm:text-xl text-bone font-normal leading-relaxed tracking-tight max-w-2xl">
          {siteData.title}
        </p>

        <!-- Brief Professional Summary -->
        <p class="font-sans text-base text-ash leading-relaxed max-w-xl">
          {siteData.about.intro}
        </p>

        <!-- Ghost Action Buttons -->
        <div class="pt-4 flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <a
            href="#projects"
            class="inline-flex items-center justify-center gap-2.5 px-5 py-3 rounded-btn border border-graphite text-sm font-sans font-medium text-white bg-transparent hover:border-white hover:bg-void transition-all duration-150 w-full sm:w-auto"
          >
            <span>View Featured Work</span>
            <svg class="w-4 h-4 text-ash" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>

          <a
            href={siteData.socials.github.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 px-5 py-3 rounded-btn border border-graphite text-sm font-mono text-ash bg-transparent hover:text-white hover:border-white transition-all duration-150 w-full sm:w-auto"
          >
            <span>github.com/kuker24</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

        <!-- Terminal Status Bar -->
        <div class="pt-6 border-t border-graphite/40 w-full flex items-center justify-between text-xs font-mono text-smoke">
          <div class="flex items-center gap-3">
            <span class="text-violet">status:</span>
            <span class="text-pulse-green">● active</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-ash">location:</span>
            <span class="text-white">Indonesia</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Personal Visual Anchor (Portrait Frame) -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="relative w-full max-w-md rounded-card border border-graphite bg-void p-3 shadow-none">
          <!-- Terminal Header Bar for Photo Box -->
          <div class="flex items-center justify-between px-3 py-2 border-b border-graphite mb-3">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-graphite"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-graphite"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-graphite"></span>
            </div>
            <span class="font-mono text-xs text-smoke">fahmi_harun.webp</span>
          </div>

          <!-- Official Portrait Image -->
          <div class="overflow-hidden rounded-lg bg-void border border-graphite/50 aspect-[1169/1541]">
            <picture>
              <source srcset={siteData.photo.webp} type="image/webp" />
              <img
                src={siteData.photo.jpeg}
                alt={siteData.photo.alt}
                width={siteData.photo.width}
                height={siteData.photo.height}
                class="w-full h-full object-cover object-top contrast-[1.02] filter transition-all duration-300"
                loading="eager"
                decoding="async"
              />
            </picture>
          </div>

          <!-- Sub-caption -->
          <div class="mt-3 px-2 py-1.5 flex items-center justify-between font-mono text-[11px] text-smoke border-t border-graphite/40">
            <span>PORTRAIT / FAHMI HARUN</span>
            <span class="text-violet">1169x1541</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

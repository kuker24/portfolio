---
import { siteData } from '../data/site';

const featured = siteData.projects.filter((project) => project.id === 'siab2' || project.id === 'siab1');
const catalog = siteData.projects.filter((project) => project.id !== 'siab2' && project.id !== 'siab1');
---

<section id="projects" class="section projects-stage scroll-mt-24">
  <div class="section-inner">
    <header class="projects-header" data-reveal>
      <h2 class="section-title">Featured <em>systems</em></h2>
      <p class="section-lede">
        Production school software and independent systems. Architecture notes come from the public repositories.
      </p>
    </header>

    <div class="project-artifacts">
      {featured.map((project) => (
        <article class="artifact" data-reveal data-project={project.id}>
          <p class="artifact-kind">{project.displayCategory}</p>
          <h3 class="artifact-name">{project.name}</h3>
          <p class="artifact-desc">{project.description}</p>
          <ul class="artifact-notes">
            {project.architectureNotes.slice(0, 3).map((note) => (
              <li>{note}</li>
            ))}
          </ul>
          <p class="artifact-stack">{project.techStack.join(' · ')}</p>
          <div class="artifact-links">
            <a
              href={project.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="pressable artifact-repo"
            >
              View on GitHub
              <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M3 9L9 3M5 3h4v4"></path>
              </svg>
            </a>
            {project.lineage && (
              <a
                href={project.lineage.url}
                target="_blank"
                rel="noopener noreferrer"
                class="artifact-lineage"
              >
                {project.lineage.label}
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    <ul class="project-catalog" data-reveal>
      {catalog.map((project) => (
        <li class="catalog-row">
          <div class="catalog-main">
            <h3>
              <a href={project.repoUrl} target="_blank" rel="noopener noreferrer">
                {project.name}
              </a>
            </h3>
            <p class="catalog-kind">{project.displayCategory}</p>
          </div>
          <p class="catalog-desc">{project.description}</p>
          <a
            class="catalog-go"
            href={project.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Open ${project.name} on GitHub`}
          >
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M3 9L9 3M5 3h4v4"></path>
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

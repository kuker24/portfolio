---
import { siteData } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="section-inner footer-inner">
    <p>© {year} {siteData.name}</p>
    <nav aria-label="Footer">
      <a href={siteData.socials.github.url} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={siteData.socials.linkedin.url} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={siteData.socials.x.url} target="_blank" rel="noopener noreferrer">X</a>
    </nav>
  </div>
</footer>

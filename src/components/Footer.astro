---
import { siteData } from '../data/site';
const currentYear = new Date().getFullYear();
---

<footer class="py-12 border-t border-graphite bg-void">
  <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-smoke">
    <div class="flex items-center gap-2">
      <span class="text-white font-medium">{siteData.name}</span>
      <span>© {currentYear}</span>
      <span class="text-ash">• Static Portfolio</span>
    </div>

    <div class="flex items-center gap-6">
      <a
        href={siteData.socials.github.url}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-white transition-colors"
      >
        GitHub
      </a>
      <a
        href={siteData.socials.linkedin.url}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-white transition-colors"
      >
        LinkedIn
      </a>
    </div>
  </div>
</footer>

---
import Layout from '../layouts/Layout.astro';
import NebulaField from '../components/NebulaField.astro';
import { siteData } from '../data/site';
---

<Layout title={`404 — Page not found | ${siteData.name}`}>
  <section class="lost-stage">
    <div class="hero-world" aria-hidden="true">
      <NebulaField />
      <div class="hero-read"></div>
    </div>
    <div class="lost-copy">
      <h1 class="hero-enter hero-family">Lost</h1>
      <p>That address is not part of this site.</p>
      <a href={`${siteData.basePath}/`} class="pressable hero-cta">Back home</a>
    </div>
  </section>
</Layout>

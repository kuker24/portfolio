---
import '../styles/global.css';
import { capabilities, principles, profile, projects } from '../data/site';

const base = import.meta.env.BASE_URL;
const pageTitle = `${profile.name} — Portfolio`;
const pageDescription = profile.summary;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#090b10" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <a class="brand" href={base} aria-label={`${profile.name} home`}>FH</a>
      <nav aria-label="Primary navigation">
        <a href="#about">About</a>
        <a href="#work">Work</a>
        <a href="#capabilities">Capabilities</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Personal portfolio · Software engineering</p>
          <h1 id="hero-title">{profile.name}</h1>
          <p class="headline">{profile.headline}</p>
          <p class="hero-summary">{profile.summary}</p>
          <div class="hero-actions">
            <a class="button primary" href="#work">Explore selected work</a>
            <a class="button secondary" href={profile.github} target="_blank" rel="noreferrer">
              GitHub profile
            </a>
            <a class="button secondary" href={profile.linkedIn} target="_blank" rel="noreferrer">
              LinkedIn profile
            </a>
          </div>
        </div>

        <div class="portrait-frame" aria-label="Portrait placeholder">
          <img
            src={`${base}profile-placeholder.svg`}
            width="720"
            height="900"
            alt="Placeholder portrait for Fahmi Harun"
          />
          <p>Replace with the verified <code>myself.jpeg</code> portrait.</p>
        </div>
      </section>

      <section id="about" class="section split-section" aria-labelledby="about-title">
        <div>
          <p class="section-index">01 · About</p>
          <h2 id="about-title">Building systems for real operational needs.</h2>
        </div>
        <div class="prose">
          <p>
            I work across frontend, backend, databases, deployment, application security, and AI-assisted
            developer workflows. My current portfolio includes education platforms used as production systems
            and technically serious personal projects.
          </p>
          <p>
            I also teach Coding and Artificial Intelligence, connecting software engineering practice with
            practical learning experiences.
          </p>
        </div>
      </section>

      <section id="work" class="section" aria-labelledby="work-title">
        <div class="section-heading">
          <div>
            <p class="section-index">02 · Selected work</p>
            <h2 id="work-title">Four projects, two different contexts.</h2>
          </div>
          <p>Production systems and serious hobby projects selected for engineering depth.</p>
        </div>

        <div class="project-grid">
          {
            projects.map((project, index) => (
              <article class="project-card">
                <div class="project-meta">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <span>{project.category}</span>
                </div>
                <h3>{project.name}</h3>
                {project.formerName && <p class="former-name">Formerly {project.formerName}</p>}
                <p>{project.summary}</p>
                <ul class="tag-list" aria-label={`${project.name} technology stack`}>
                  {project.stack.map((item) => <li>{item}</li>)}
                </ul>
                <a class="project-link" href={project.repository} target="_blank" rel="noreferrer">
                  View source on GitHub <span aria-hidden="true">↗</span>
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <section id="capabilities" class="section split-section" aria-labelledby="capabilities-title">
        <div>
          <p class="section-index">03 · Capabilities</p>
          <h2 id="capabilities-title">End-to-end engineering focus.</h2>
        </div>
        <ul class="capability-list">
          {capabilities.map((capability) => <li>{capability}</li>)}
        </ul>
      </section>

      <section class="section principles" aria-labelledby="principles-title">
        <div class="section-heading">
          <div>
            <p class="section-index">04 · Principles</p>
            <h2 id="principles-title">How I approach software.</h2>
          </div>
        </div>
        <ul class="principle-grid">
          {principles.map((principle, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span>{principle}</li>
          ))}
        </ul>
      </section>

      <section id="contact" class="section contact" aria-labelledby="contact-title">
        <p class="section-index">05 · Contact</p>
        <h2 id="contact-title">Find my work and professional profile.</h2>
        <p>
          Review my repositories and project history on GitHub, or connect through my verified LinkedIn profile.
          Public email and downloadable CV remain intentionally unset until separately confirmed.
        </p>
        <div class="hero-actions">
          <a class="button primary" href={profile.github} target="_blank" rel="noreferrer">Open GitHub</a>
          <a class="button secondary" href={profile.linkedIn} target="_blank" rel="noreferrer">Open LinkedIn</a>
        </div>
      </section>
    </main>

    <footer>
      <p>© {new Date().getFullYear()} {profile.name}</p>
      <p>Static Astro portfolio hosted on GitHub Pages.</p>
    </footer>
  </body>
</html>
